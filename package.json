{
  "name": "aulify",
  "version": "0.1.0",
  "private": true,
  "description": "Recursos de clase interactivos para educación secundaria",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests *.ts *.mjs *.json .github/workflows/*.yml",
    "format": "prettier --write src tests *.ts *.mjs *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "@blocknote/ariakit": "0.55.0",
    "@blocknote/core": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "type": "module"
}
