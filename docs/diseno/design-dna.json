      "mobile": "Composición vertical; navegación desplegable",
      "maxReadingWidthPx": 800
    },
    "shape": {
      "buttonRadiusPx": 10,
      "cardRadiusPx": 16,
      "illustration": "Contorno negro y curvas orgánicas"
    },
