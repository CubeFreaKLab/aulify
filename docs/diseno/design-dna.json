      "durationMs": {
        "fast": 150,
        "medium": 250,
        "long": 350
      },
      "easing": {
        "standard": "cubic-bezier(.2,0,0,1)",
        "enter": "cubic-bezier(0,0,0,1)",
        "exit": "cubic-bezier(.3,0,1,1)"
      },
      "reference": "https://m3.material.io/styles/motion/transitions/transition-patterns",
      "reducedMotion": "Composición estática y transiciones inmediatas"
    },
    "components": {
      "controls": "React Aria con estilos Aulify",
      "editor": "BlockNote con Ariakit y bloque de actividad",
      "questions": "Una consigna y alternativas amplias",
      "feedback": "Según política de visibilidad de actividad"
    }
  },
  "design_style": {
    "mood": [
      "cercano",
      "curioso",
      "claro"
    ],
    "audience": "Docentes y estudiantes de secundaria",
    "composition": "Materiales escolares organizados hasta formar una clase; superficies de trabajo tranquilas",
    "imagery": "Ilustración lineal negra con verde, sin infantilización",
    "voice": "Español directo, acciones comprensibles",
    "ornamentation": "Concentrada en la portada; orientada a la tarea dentro del aula"
  },
  "visual_effects": {
    "overview": {
      "effect_intensity": "moderada en portada, baja en plataforma",
      "performance_tier": "CSS y DOM"
    },
    "scroll": {
      "enabled": true,
      "effect": "Líneas de tiempo CSS por plano, composición móvil con desplazamiento acotado; alternativa estática sin soporte o con movimiento reducido"
    },
    "webgl": {
      "enabled": false
    },
    "particles": {
      "enabled": false
    },
    "cursorEffects": {
      "enabled": false
    },
    "transitions": {
      "enabled": true,
      "patterns": [
        "container transform",
        "forward/backward",
        "lateral",
        "top level",
        "enter/exit",
        "skeleton"
      ]
    },
    "composite_notes": "Logo SVG original y cuaderno vectorizado en 427 trazados; preguntas HTML. Cambio de tema con View Transitions cuando existe soporte y no se solicita movimiento reducido."
