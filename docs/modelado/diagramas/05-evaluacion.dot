digraph modelo {
graph [rankdir=LR, bgcolor="#ffffff", pad=0.4, nodesep=0.4, ranksep=1.1, splines=polyline, fontname="Arial", fontsize=20, labelloc=t, label="Entregas y evaluación · modelo lógico 1.3"];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, color="#668076", arrowsize=0.6];
