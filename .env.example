NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel Production deshabilita la demo automáticamente. false permite probar ese estado localmente.
AULIFY_DEMO_ENABLED=true
# Solo servidor; no añadir el prefijo NEXT_PUBLIC_ ni publicar un valor real.
SUPABASE_SECRET_KEY=replace_with_server_secret
# Opcional, solo servidor. Pooler transaccional, puerto 6543, sin parámetros SSL.
# El cliente verifica el certificado TLS. Nunca publicar una conexión real.
AULIFY_DATABASE_URL=
